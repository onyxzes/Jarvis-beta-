<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#04080F">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="JARVIS"
        android:textColor="#3FE0FF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.3"
        android:gravity="center"
        android:paddingTop="20dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/estado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Desactivado"
        android:textColor="#6F93A6"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <!-- Pantalla ACTIVAR -->
    <LinearLayout
        android:id="@+id/pantallaActivar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:text="ACTIVAR"
            android:textSize="20sp"
            android:textColor="#04080F"
            android:backgroundTint="#3FE0FF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cuando esté activado escucha y responde.\nAl decir o tocar apagar, se apaga 100%."
            android:textColor="#6F93A6"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingTop="20dp" />
    </LinearLayout>

    <!-- Pantalla BOVEDA -->
    <LinearLayout
        android:id="@+id/pantallaBoveda"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bóveda"
            android:textColor="#3FE0FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="10dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/textoBoveda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Todavía no hay nada guardado.\nAcá va a aparecer toda la memoria: notas, gastos, transferencias y resúmenes."
                android:textColor="#D8F6FF"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />
        </ScrollView>
    </LinearLayout>

    <!-- Pantalla CONTROL -->
    <LinearLayout
        android:id="@+id/pantallaControl"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Control"
            android:textColor="#3FE0FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="14dp" />

        <Button
            android:id="@+id/btnProbarVoz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Probar voz de hombre"
            android:textColor="#3FE0FF"
            android:backgroundTint="#0A1422" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Próximamente: permisos de micrófono, notificaciones y accesibilidad; elegir IA; avisos de plata."
            android:textColor="#6F93A6"
            android:textSize="13sp"
            android:paddingTop="16dp" />
    </LinearLayout>

    <!-- Barra inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0A1422">

        <Button
            android:id="@+id/navActivar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Inicio"
            android:textSize="12sp"
            android:textColor="#3FE0FF"
            android:backgroundTint="#0A1422" />

        <Button
            android:id="@+id/navBoveda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bóveda"
            android:textSize="12sp"
            android:textColor="#6F93A6"
            android:backgroundTint="#0A1422" />

        <Button
            android:id="@+id/navControl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Control"
            android:textSize="12sp"
            android:textColor="#6F93A6"
            android:backgroundTint="#0A1422" />
    </LinearLayout>

</LinearLayout>
