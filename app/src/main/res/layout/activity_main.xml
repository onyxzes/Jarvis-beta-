<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#04080F">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="JARVIS"
        android:textColor="#3FE0FF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.3"
        android:gravity="center"
        android:paddingTop="20dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/estado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Desactivado"
        android:textColor="#6F93A6"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <!-- Pantalla ACTIVAR -->
    <LinearLayout
        android:id="@+id/pantallaActivar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:text="ACTIVAR"
            android:textSize="20sp"
            android:textColor="#04080F"
            android:backgroundTint="#3FE0FF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cuando esté activado escucha y responde.\nAl decir o tocar apagar, se apaga 100%."
            android:textColor="#6F93A6"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingTop="20dp" />
    </LinearLayout>

    <!-- Pantalla BOVEDA -->
    <LinearLayout
        android:id="@+id/pantallaBoveda"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bóveda"
            android:textColor="#3FE0FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="10dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/textoBoveda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Todavía no hay nada guardado.\nAcá va a aparecer toda la memoria: notas, gastos, transferencias y resúmenes."
                android:textColor="#D8F6FF"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />
        </ScrollView>
    </LinearLayout>

    <!-- Pantalla CONTROL -->
    <ScrollView
        android:id="@+id/pantallaControl"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Control"
            android:textColor="#3FE0FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="14dp" />

        <Button
            android:id="@+id/btnProbarVoz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Probar voz"
            android:textColor="#3FE0FF"
            android:backgroundTint="#0A1422" />

        <Button
            android:id="@+id/btnCambiarVoz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cambiar voz"
            android:textColor="#3FE0FF"
            android:backgroundTint="#0A1422"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/vozActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voz: por defecto"
            android:textColor="#6F93A6"
            android:textSize="12sp"
            android:paddingTop="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tocá “Cambiar voz” hasta encontrar una de hombre que te guste. Queda guardada."
            android:textColor="#6F93A6"
            android:textSize="13sp"
            android:paddingTop="12dp"
            android:paddingBottom="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clave de Gemini (IA)"
            android:textColor="#3FE0FF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/campoClave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pegá acá tu clave de Gemini"
            android:textColorHint="#55707F"
            android:textColor="#D8F6FF"
            android:textSize="14sp"
            android:background="#0A1422"
            android:padding="12dp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnGuardarClave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar clave"
            android:textColor="#04080F"
            android:backgroundTint="#3FE0FF"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sacá tu clave gratis en aistudio.google.com/apikey\n\nPróximamente: leer notificaciones, buscar gastos y chats, control del teléfono."
            android:textColor="#6F93A6"
            android:textSize="13sp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp" />
    </LinearLayout>
    </ScrollView>

    <!-- Barra inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0A1422">

        <Button
            android:id="@+id/navActivar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Inicio"
            android:textSize="12sp"
            android:textColor="#3FE0FF"
            android:backgroundTint="#0A1422" />

        <Button
            android:id="@+id/navBoveda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bóveda"
            android:textSize="12sp"
            android:textColor="#6F93A6"
            android:backgroundTint="#0A1422" />

        <Button
            android:id="@+id/navControl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Control"
            android:textSize="12sp"
            android:textColor="#6F93A6"
            android:backgroundTint="#0A1422" />
    </LinearLayout>

</LinearLayout>
